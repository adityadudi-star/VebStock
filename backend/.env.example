# Copy to .env for local development. Never commit .env.

# Local development may use SQLite (default if unset). Production must use PostgreSQL, e.g.
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME      (Render "Internal Database URL" for the web service)
DATABASE_URL=sqlite:///./data/dev.db

# Comma-separated browser origins allowed to call this API (no wildcard).
# Production: your Vercel URL, e.g. https://vebstock.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for Vercel preview deployments
CORS_ORIGIN_REGEX=

ENVIRONMENT=development
LOG_LEVEL=INFO
# Directory for trained LightGBM model files (offline jobs only; ephemeral on Render)
MODEL_DIR=./data/models
# Reserved for an optional LLM assistant (not used: the shipped assistant is rule-based)
LLM_API_KEY=

# Role-based access. Keep AUTH_REQUIRED=true everywhere except local development.
AUTH_REQUIRED=true
# Long random string used to sign session tokens. REQUIRED when ENVIRONMENT=production.
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
AUTH_TOKEN_HOURS=12
